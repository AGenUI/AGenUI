<?xml version="1.0" encoding="utf-8"?>
<!--
 Custom scanner layout for PortraitCaptureActivity.

 Mirrors the default zxing_capture layout (same DecoratedBarcodeView id and
 attributes) and adds a close (X) button so the user can exit the scanner
 without scanning, matching the system scanner behavior on HarmonyOS.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <ImageButton
        android:id="@+id/btn_close_scan"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_scan_close"
        android:contentDescription="@string/action_close_scan"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close_scan" />

</FrameLayout>
