# ============================================================================
# AGenUI monorepo - Root .gitignore
#
# Design principles:
#   - Root .gitignore only contains cross-platform general rules (OS, IDE, temp files, common artifacts)
#   - Platform-specific rules (Pods/, build/, oh_modules/, etc.) go into platforms/<plat>/.gitignore
#   - Do not override or duplicate rules already defined in sub .gitignore files
# ============================================================================

# ---------------------- OS Files ----------------------
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------- General IDE / Editors ----------------------
# JetBrains family (IntelliJ IDEA / Android Studio / DevEco Studio / CLion)
.idea/
*.iml
*.ipr
*.iws

.qoder/
.claude/

# VS Code (to keep shared configs like .vscode/extensions.json, negate as needed)
.vscode/
*.code-workspace

# Vim / Emacs / Sublime
*.swp
*.swo
*~
.*.sw[a-p]
*.sublime-workspace
*.sublime-project

# Local cache for AI tools such as Cursor / Aone Copilot
.cursor/
.aone_copilot/

# ---------------------- General Build Artifacts ----------------------
# General build directories
build/
build-framework/
out/
dist/
target/
Templates/
vendor/
Pods/

# Common CMake artifacts (may be generated under core/, etc.)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!cmake/**/*.cmake
compile_commands.json
.cmake/

# General temporary files
*.tmp
*.temp
*.log
*.bak

# ---------------------- Node.js (may be used by scripting toolchain) ----------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# ---------------------- Python (may be generated by helper scripts) ----------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------------- Prebuilt Artifacts / Git LFS Placeholders ----------------------
# Actual artifacts under prebuilts/ will be tracked via LFS in the future; locally built copies are excluded from git
prebuilts/**/*.xcframework/
prebuilts/**/*.framework/
prebuilts/**/*.aar
prebuilts/**/*.har
prebuilts/**/*.so
prebuilts/**/*.a
prebuilts/**/*.dSYM/
prebuilts/**/*.zip

# ---------------------- Documentation Site Build Artifacts ----------------------
docs/.docusaurus/
docs/build/
docs/node_modules/
docs/_site/

# ---------------------- Xcode user data ----------------------
xcuserdata/
*.xcuserdatad/

# ---------------------- Test artifacts ----------------------
test/output/
reports/
/qa-outputs/

# Suite case copies materialized by test/scripts/materialize_suite.py.
# Regenerate from <suite>/cases.txt; the cases themselves live in test/cases/.
test/suites/*/cases/

# Inverted index built by test/scripts/case_index.py from the cases themselves.
# A pure cache: it must be rebuilt after any change under test/cases/ or a
# branch switch, so a committed copy would only ever be stale.
test/cases/.case_index.json

# C++ test build directories (generated by cmake, per-sanitizer)
tests/cpp/build*/

# ASan runtime .so (copied from NDK at build time by scripts/android/build_asan.sh)
playground/android/app/src/main/resources/lib/arm64-v8a/*.so

# Synced from playground/resource/test_fixtures/ to each platform's copy at script runtime (required for runtime packaging)
playground/harmony/entry/src/main/resources/rawfile/test_fixtures/
playground/ios/Playground/AGenUITests/test_fixtures/

# ---------------------- Other General Sensitive / Local Files ----------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# ---------------------- Third-party vendor sources (downloaded at build time) ----------------------
vendor/

# ---------------------- iOS Playground template archive ----------------------
playground/ios/Playground/Playground\ for\ AGenUI/Templates.zip

# ---------------------- Artifacts ----------------------
.harmony_output/

# HarmonyOS test build intermediates (generated by hvigorw test)
platforms/harmony/agenui/.test/
playground/harmony/**/.test/

platforms/android/processor/

# ---------------------- Artifacts ----------------------
# Unified output directory for all three platforms (overwritten on each build; use git tag / CI artifact for persistence)
/dist/

# ---------------------- Playground local config ----------------------
playground/harmony/build-profile.json5
playground/ios/Playground/Playground for AGenUI/Templates/A2UI Show/AudioPlayer/updateComponents.json
playground/ios/Playground/Playground for AGenUI/Templates/A2UI Show/Button/updateComponents.json
playground/ios/Playground/Playground for AGenUI/Templates/A2UI Show/Card/updateComponents.json
playground/ios/Playground/Playground for AGenUI/Templates/A2UI Show/Carousel/updateComponents.json
playground/ios/Playground/Playground for AGenUI/Templates/A2UI Show/Chart/updateComponents.json
playground/ios/Playground/Playground for AGenUI/Templates/A2UI Show/CheckBox/updateComponents.json
